# ---- LLM (free: https://aistudio.google.com/apikey — no credit card) ----
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ---- Sandboxes ----
# local | daytona | docker
SANDBOX_PROVIDER=local
DAYTONA_API_KEY=

# ---- Database (free: https://neon.tech) ----
DATABASE_URL=

# ---- Git (fine-grained PAT: contents:write — used only to push worker branches) ----
GITHUB_TOKEN=
GIT_AUTHOR_NAME=kapi-agent
GIT_AUTHOR_EMAIL=agent@kapi.local

# ---- Orchestrator ----
ORCHESTRATOR_PORT=8787
ORCHESTRATOR_PUBLIC_URL=http://host.docker.internal:8787

# ---- Free-tier guardrails ----
# Gemini free tier caps requests PER MODEL PER DAY (measured: 20).
# The provider rotates across models, so real capacity is ~20 x model count.
MAX_LLM_REQUESTS_PER_RUN=60
MAX_LLM_TOKENS_PER_RUN=400000
MAX_CONCURRENT_WORKERS=4
SANDBOX_IDLE_TTL_SECONDS=900
