# ---- LLM (free: https://aistudio.google.com/apikey — no credit card) ----
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ---- Sandboxes ----
# local | daytona | docker
SANDBOX_PROVIDER=local
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# ---- Database (free: https://neon.tech) ----
DATABASE_URL=

# ---- Message bus (optional: https://upstash.com) ----
# Use redis for multi-instance orchestration; defaults to inprocess.
KAPI_BUS=inprocess
# Upstash REST credentials are converted to a TLS Redis connection internally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, provide a Redis protocol URL (rediss://...).
REDIS_URL=

# ---- Git, single-operator ----
# A fine-grained PAT (contents:write). Everything below is optional; with only
# this set, kapi runs exactly as it always has: one user, one credential, no
# login. This is what the CLI and `pnpm smoke` use.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=kapi-agent
GIT_AUTHOR_EMAIL=agent@kapi.local

# ---- Multi-user (all optional; leave blank to stay single-operator) ----
# workos | none. Defaults to workos once WORKOS_CLIENT_ID is set, else none.
KAPI_AUTH_MODE=

# Who is signing in. https://workos.com — free up to 1M monthly active users.
# The GitHub connection uses WorkOS Pipes, so kapi never stores a GitHub token:
# enable the GitHub provider in Pipes before connecting repositories.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# What a sandbox is allowed to touch. Create a GitHub App with Contents
# read/write, installable on any account, webhooks off. Users install it on the
# repositories they want kapi to work on, and each sandbox receives a token
# scoped to that one repository for an hour - never the user's own token.
# The private key may be the PKCS#1 PEM GitHub downloads, a PKCS#8 PEM, a PEM
# with escaped newlines, or base64 of any of those.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ---- Orchestrator ----
ORCHESTRATOR_PORT=8787
ORCHESTRATOR_PUBLIC_URL=http://host.docker.internal:8787

# ---- Free-tier guardrails ----
# Gemini free tier caps requests PER MODEL PER DAY (measured: 20).
# The provider rotates across models, so real capacity is ~20 x model count.
MAX_LLM_REQUESTS_PER_RUN=60
MAX_LLM_TOKENS_PER_RUN=400000
MAX_CONCURRENT_WORKERS=4
# Requests (not actions) one worker may spend; each request carries an action batch.
KAPI_MAX_REQUESTS_PER_TASK=10
SANDBOX_IDLE_TTL_SECONDS=900
