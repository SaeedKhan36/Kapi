# ---- LLM (free: https://aistudio.google.com/apikey — no credit card) ----
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ---- Sandboxes ----
# local | daytona | docker
SANDBOX_PROVIDER=local
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# ---- Database (free: https://neon.tech) ----
# Unset uses an embedded PGlite in .kapi/db, which is single-writer and for
# development only. A built artifact (pnpm build, or the Docker image) has no
# embedded database at all - PGlite ships WebAssembly that cannot be bundled -
# so anything deployed needs a real connection string here.
# Apply the schema with `pnpm db:migrate`; on a database that already has these
# tables, adopt it with `pnpm db:migrate --baseline`.
DATABASE_URL=

# ---- Git, single-operator ----
# A fine-grained PAT (contents:write). Everything below is optional; with only
# this set, kapi runs exactly as it always has: one user, one credential, no
# login. This is what the CLI and `pnpm smoke` use.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=kapi-agent
GIT_AUTHOR_EMAIL=agent@kapi.local

# ---- Multi-user (all optional; leave blank to stay single-operator) ----
# clerk | workos | none. Defaults to whichever provider is configured below,
# preferring clerk; with neither, kapi stays single-operator and skips login.
KAPI_AUTH_MODE=

# Who is signing in. https://clerk.com — free up to 10k monthly active users.
# The dashboard reads CLERK_PUBLISHABLE_KEY directly (it is public by design);
# CLERK_SECRET_KEY never leaves the orchestrator. Enable GitHub as a social
# connection in Clerk — with the `repo` scope — before connecting repositories,
# and kapi borrows that grant per request rather than storing a token.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Only needed if the instance's Frontend API is not the one encoded in the
# publishable key (custom domains usually are).
CLERK_ISSUER=

# Alternative to Clerk: https://workos.com — free up to 1M monthly active users.
# API-only today: the dashboard ships Clerk UI, not AuthKit. Use Clerk for a
# hosted multi-user deploy. WORKOS_REDIRECT_URI is reserved for a future
# AuthKit route and is ignored by the current dashboard.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# What a sandbox is allowed to touch. Create a GitHub App with Contents
# read/write, installable on any account, webhooks off. Users install it on the
# repositories they want kapi to work on, and each sandbox receives a token
# scoped to that one repository for an hour - never the user's own token.
# The private key may be the PKCS#1 PEM GitHub downloads, a PKCS#8 PEM, a PEM
# with escaped newlines, or base64 of any of those.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ---- Message bus ----
# inprocess (default) | redis. One orchestrator needs nothing here; more than
# one needs Redis, or agents on different instances cannot hear each other.
# KAPI_BUS=redis without a working REDIS_URL refuses to start rather than
# falling back, because that fallback fails silently.
KAPI_BUS=inprocess
# Must be the TCP endpoint, not a REST one: the bus holds a subscription open.
# Upstash shows it on the database page as rediss://default:<password>@host:6379
# - the REST token is NOT that password.
REDIS_URL=

# ---- Orchestrator ----
ORCHESTRATOR_PORT=8787
# How docker sandboxes reach this process (host-gateway in compose).
ORCHESTRATOR_PUBLIC_URL=http://host.docker.internal:8787
# Production dashboard hostname (Caddy / KAPI_PUBLIC_URL).
KAPI_HOST=
# Extra browser origins allowed to call the API directly, comma-separated.
# Leave empty: single-operator reflects any origin; Clerk/WorkOS reflect none
# besides KAPI_PUBLIC_URL, because the dashboard proxies /api same-origin.
KAPI_CORS_ORIGINS=
# Image SANDBOX_PROVIDER=docker runs. Built by `docker compose build`.
KAPI_AGENT_IMAGE=kapi/agent:latest

# Production dashboard (`pnpm start:web` / the web container) forwards /api and
# /ws here. Vite does the same in development against ORCHESTRATOR_PORT.
ORCHESTRATOR_URL=http://localhost:8787
# Where the dashboard's production server forwards /api and /ws. In dev, vite's
# proxy does this instead and follows ORCHESTRATOR_PORT.
ORCHESTRATOR_URL=http://localhost:8787

# ---- Free-tier guardrails ----
# Gemini free tier caps requests PER MODEL PER DAY (measured: 20).
# The provider rotates across models, so real capacity is ~20 x model count.
MAX_LLM_REQUESTS_PER_RUN=60
MAX_LLM_TOKENS_PER_RUN=400000
# Hard ceilings, not just defaults: a caller asking for more is clamped down to
# these. Workers bound how many sandboxes exist at once; tasks bound how many a
# run creates in total, which is the number that decides what it costs. A plan
# that comes back longer than MAX_TASKS_PER_RUN is trimmed to a
# dependency-closed prefix, and the run says which tasks it dropped.
MAX_CONCURRENT_WORKERS=4
MAX_TASKS_PER_RUN=8

# Workers-per-run is the wrong unit for money: ten runs of four workers is
# forty billable sandboxes. This is the ceiling over everything at once,
# enforced per orchestrator process - divide it if you run more than one.
# Keep it above MAX_CONCURRENT_WORKERS, since a worker holds its sandbox while
# its reviewer opens another; a creation that cannot get a slot within
# SANDBOX_SLOT_WAIT_MS fails rather than hanging.
MAX_CONCURRENT_SANDBOXES=12
SANDBOX_SLOT_WAIT_MS=120000

# What one caller may ask for. Sized as a guard against a loop, not as a quota:
# a free Gemini key affords roughly four to six runs a day anyway.
MAX_RUNS_PER_HOUR=20
MAX_RUN_BURST=5
MAX_CONCURRENT_RUNS=5
MAX_CONCURRENT_RUNS_PER_USER=2
# Requests (not actions) one worker may spend; each request carries an action batch.
KAPI_MAX_REQUESTS_PER_TASK=10
SANDBOX_IDLE_TTL_SECONDS=900
